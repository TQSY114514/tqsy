};
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  
  <link rel="preconnect" href="https://videotourl.com" crossorigin />

  <meta name="theme-color" content="#fcfcfc" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0a0a0c" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href={globalIcon} />
  <link rel="apple-touch-icon" href={globalIcon} />

  <meta name="description" content={description} />
  <meta name="keywords" content="TQSY, Weather Holy Salt, tqishengyan, 天气圣盐, 个人主页, 极客, 初音未来" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={globalIcon} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={siteUrl} />
  <meta property="og:site_name" content="TQSY's Space" />
  <meta property="og:locale" content="zh_CN" />
  <meta name="twitter:card" content="summary_large_image" />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <style>
    :root {
      --miku-green: #00cfb5;
      --miku-blue: #00a3e0;
      --bg-white: #fcfcfc;
      --text-dark: #1d1d1f;
      --text-gray: #86868b;
      
      --vp-glass: linear-gradient(135deg, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0.05));
      --vp-glass-border: rgba(255, 255, 255, 0.15);
      --vp-glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
      --glass-hover: rgba(0, 207, 181, 0.08);
      
      --ease: cubic-bezier(0.16, 1, 0.3, 1);
      --dot-color: rgba(0, 0, 0, 0.03);
      --noise-opacity: 0.015;
      --particle-theme: rgba(80, 130, 120, 0.25); 
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg-white: #0a0a0c;
        --text-dark: #f5f5f7;
        --text-gray: #a1a1a6;
        
        --vp-glass: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
        --vp-glass-border: rgba(255, 255, 255, 0.08);
        --vp-glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        --glass-hover: rgba(0, 207, 181, 0.15);
        
        --dot-color: rgba(255, 255, 255, 0.02);
        --noise-opacity: 0.025;
        --particle-theme: rgba(160, 210, 200, 0.2);
      }
    }

    /* ✨ a11y: 全局无障碍焦点光环 */
    *:focus-visible { outline: 2px solid var(--miku-green); outline-offset: 4px; border-radius: inherit; }
    ::selection { background-color: var(--miku-green); color: #ffffff; }

    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; }
    ::-webkit-scrollbar { width: 0px; height: 0px; }

    body { 
      background-color: var(--bg-white); color: var(--text-dark); 
      font-family: -apple-system, BlinkMacSystemFont, system-ui, "Segoe UI", Roboto, "SF Pro Text", sans-serif; 
      overflow-x: hidden;
      transition: background-color 0.5s var(--ease), color 0.5s var(--ease);
    }

    .bg-system { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; pointer-events: none; }
    
    .bg-glow-1 { 
      position: absolute; top: -20%; right: -20%; width: 80vmax; height: 80vmax; 
      background: radial-gradient(closest-side, rgba(0, 207, 181, 0.15) 0%, rgba(0, 207, 181, 0) 100%); 
      animation: aurora-1 10s infinite ease-in-out;
    }
    .bg-glow-2 { 
      position: absolute; bottom: -20%; left: -20%; width: 80vmax; height: 80vmax; 
      background: radial-gradient(closest-side, rgba(0, 163, 224, 0.12) 0%, rgba(0, 163, 224, 0) 100%); 
      animation: aurora-2 12s infinite ease-in-out;
    }
    .particle-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
    
    .bg-grid {
      position: absolute; inset: 0; background-image: radial-gradient(var(--dot-color) 1px, transparent 1px); background-size: 24px 24px;
    }
    .bg-noise {
      position: absolute; inset: 0; opacity: var(--noise-opacity);
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    }

    @keyframes aurora-1 { 0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.7; } 50% { transform: translate(-5%, 5%) scale(1.1); opacity: 1; } }
    @keyframes aurora-2 { 0%, 100% { transform: translate(0, 0) scale(1.1); opacity: 1; } 50% { transform: translate(5%, -5%) scale(0.9); opacity: 0.6; } }

    .hero { height: 100dvh; display: flex; flex-direction: column; justify-content: center; align-items: center; user-select: none; -webkit-user-select: none; }

    .hero h1 { 
      font-size: clamp(3.2rem, 10vw, 6.5rem); font-weight: 800; 
      background: linear-gradient(var(--text-dark), var(--text-gray)); 
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; 
      animation: titleReveal 1.2s var(--ease) 0.1s both; 
      line-height: 1.1; margin-bottom: 12px;
    }
    @keyframes titleReveal { 0% { opacity: 0; filter: blur(12px); transform: translateY(15px); } 100% { opacity: 1; filter: blur(0); transform: translateY(0); } }
    
    .typewriter-box { display: flex; align-items: center; justify-content: center; height: 20px; opacity: 0; animation: titleReveal 1s var(--ease) 0.5s both; }
    .hero-sub { color: var(--text-gray); letter-spacing: 0.15em; text-transform: uppercase; font-size: 0.85rem; font-family: monospace; font-weight: 600; }
    .cursor { display: inline-block; width: 1ch; height: 1.1em; background-color: var(--miku-green); margin-left: 6px; animation: blink 1s step-end infinite; }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

    .container { max-width: 580px; margin: 0 auto; padding: 0 20px 250px 20px; }

    .category-title {
      font-family: monospace;
      font-size: 11px; font-weight: 700; color: var(--text-gray); letter-spacing: 0.2em; text-transform: uppercase;
      margin: 40px 0 16px 12px; opacity: 0; transform: translateY(20px);
      transition: opacity 0.8s var(--ease), transform 0.8s var(--ease);
    }
    .category-title.show { opacity: 0.8; transform: translateY(0); }

    .nav-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 8px; }
    /* ✨ 当分类为奇数个卡片时（如 Gaming 的 3 个），最后一项自动横跨两列居中托底 */
    .nav-grid > .nav-item:last-child:nth-child(odd) { grid-column: span 2; }

    .vp-glass {
      background: var(--vp-glass); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--vp-glass-border); box-shadow: var(--vp-glass-shadow);
    }

    .nav-item { 
      display: flex; align-items: center; justify-content: space-between; 
      padding: 20px 24px; border-radius: 24px; text-decoration: none; 
      color: var(--text-dark); font-weight: 600; opacity: 0; transform: translateY(30px);
      transition: opacity 0.8s var(--ease), transform 0.8s var(--ease), border-color 0.4s var(--ease), box-shadow 0.4s var(--ease), background-color 0.5s var(--ease);
      user-select: none; -webkit-user-select: none; height: 100%;
    }
    .nav-item:hover, .nav-item:active { will-change: transform, opacity; }
    
    .nav-left-zone { display: flex; align-items: center; gap: 14px; }
    .nav-item svg { width: 18px; height: 18px; fill: currentColor; flex-shrink: 0; transition: transform 0.4s var(--ease); }
    .nav-item span { transition: color 0.4s var(--ease); }
    .nav-item .arrow { color: var(--text-gray); opacity: 0.6; font-family: monospace; }
    .nav-item.show { opacity: 1; transform: translateY(0); }
    
    @media (hover: hover) {
      .nav-item.show:hover { transform: translateY(-4px); border-color: var(--miku-green); box-shadow: 0 10px 40px rgba(0,207,181,0.15); }
      .nav-item.show:hover span { color: var(--miku-green); }
      .nav-item.show:hover svg { transform: scale(1.1); color: var(--miku-green); }
    }
    .nav-item.show:active { transform: scale(0.97); background: var(--glass-hover); transition: transform 0.1s, background 0.1s; }

    .source-footer { text-align: center; margin-top: 60px; opacity: 0; animation: fadeIn 1.5s var(--ease) 1s forwards; }
    @keyframes fadeIn { to { opacity: 1; } }
    .source-footer a { display: inline-flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--text-gray); text-decoration: none; letter-spacing: 0.05em; transition: color 0.3s var(--ease), opacity 0.3s var(--ease); user-select: none; -webkit-user-select: none; opacity: 0.6; }
    .source-footer svg { width: 13px; height: 13px; fill: currentColor; }
    @media (hover: hover) { .source-footer a:hover { color: var(--miku-green); opacity: 1; } }

    .player-card { 
      position: fixed; left: 25px; bottom: 25px; width: 320px; padding: 14px; 
      border-radius: 24px; display: flex; flex-direction: column; gap: 12px; 
      z-index: 1000; opacity: 0; animation: slideInLeft 1.2s var(--ease) 1s forwards;
      will-change: transform, opacity; user-select: none; -webkit-user-select: none;
    }
    @keyframes slideInLeft { from { opacity: 0; transform: translateX(-30px); } to { opacity: 1; transform: translateX(0); } }

    .player-upper { display: flex; align-items: center; gap: 12px; }
    .album-cover { width: 44px; height: 44px; border-radius: 12px; object-fit: cover; transition: 0.4s var(--ease); pointer-events: none; }
    .is-playing .album-cover { box-shadow: 0 0 20px rgba(0,207,181,0.25); transform: scale(1.02); }

    .song-info { flex: 1; overflow: hidden; }
    .song-name { font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .song-artist { font-size: 11px; color: var(--miku-green); margin-top: 1px; font-weight: 500; }
    
    .play-pause { 
      width: 34px; height: 34px; background: var(--text-dark); color: var(--bg-white); 
      border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: transform 0.2s; flex-shrink: 0;
    }
    .play-pause:active { transform: scale(0.88); transition: transform 0.1s; }
    .play-pause svg { width: 14px; height: 14px; fill: currentColor; }
    #icon-pause { display: none; }
    .is-playing #icon-play { display: none; }
    .is-playing #icon-pause { display: block; }

    .player-progress-zone { display: flex; flex-direction: column; gap: 4px; padding: 0 2px; position: relative; }
    .progress-bar-bg { width: 100%; height: 4px; background: rgba(0,0,0,0.06); border-radius: 2px; position: relative; overflow: hidden; }
    @media (prefers-color-scheme: dark) { .progress-bar-bg { background: rgba(255,255,255,0.1); } }
    .progress-bar-fill { position: absolute; left: 0; top: 0; height: 100%; width: 0%; background: var(--miku-green); border-radius: 2px; transition: width 0.1s linear; pointer-events: none; }
    
    .progress-slider {
      -webkit-appearance: none; appearance: none;
      width: 100%; height: 100%; position: absolute; top: 0; left: 0; margin: 0;
      background: transparent; outline: none; z-index: 2; cursor: pointer;
    }
    .progress-slider::-webkit-slider-thumb { -webkit-appearance: none; width: 0; height: 0; }
    .progress-slider::-moz-range-thumb { width: 0; height: 0; border: none; }

    .player-time-labels { display: flex; justify-content: space-between; font-size: 9px; color: var(--text-gray); font-family: monospace; letter-spacing: 0.05em; pointer-events: none; }

    .contact-panel { 
      position: fixed; right: 25px; bottom: 25px; 
      display: flex; flex-direction: column; align-items: flex-end; gap: 8px; 
      z-index: 1001; pointer-events: none; 
      visibility: hidden; transition: visibility 0.4s;
    }
    body.is-bottom .contact-panel { pointer-events: auto; visibility: visible; }

    .email-chip { 
      --chip-x: 40px; --chip-op: 0;
      padding: 8px 16px; border-radius: 50px; font-size: 10px; 
      color: var(--text-gray); text-decoration: none; font-family: monospace; 
      cursor: pointer; transform: translateX(var(--chip-x)); opacity: var(--chip-op);
      transition: background 0.3s, color 0.3s, border 0.3s, transform 0.4s var(--ease), opacity 0.4s; user-select: none; -webkit-user-select: none;
    }
    .email-chip:not([data-ready]) { opacity: 0 !important; pointer-events: none; }

    @media (hover: hover) { .email-chip:hover { background: var(--miku-green); color: white; border-color: var(--miku-green); transform: translateX(calc(var(--chip-x) - 5px)); } }

    @media (max-width: 600px) {
      .nav-grid { grid-template-columns: 1fr; }
      .nav-grid > .nav-item:last-child:nth-child(odd) { grid-column: span 1; }
      .hero h1 { font-size: 3.2rem !important; margin-bottom: 10px; }
      .hero-sub { font-size: 0.75rem; }
      .player-card { width: 190px !important; left: 10px !important; bottom: 10px !important; padding: 10px !important; gap: 6px !important; border-radius: 18px !important; }
      .album-cover { width: 32px !important; height: 32px !important; border-radius: 8px !important; }
      .song-name { font-size: 11px !important; }
      .song-artist { font-size: 9px !important; }
      .play-pause { width: 26px !important; height: 26px !important; }
      .play-pause svg { width: 10px !important; height: 10px !important; }
      .player-time-labels { font-size: 8px !important; }
      .progress-bar-bg { height: 3px !important; }
      .contact-panel { right: 10px !important; bottom: 10px !important; gap: 4px !important; }
      .email-chip { padding: 5px 10px !important; font-size: 8.5px !important; }
      .nav-item { padding: 18px 20px !important; border-radius: 20px !important; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
      .nav-item, .category-title { opacity: 1; transform: translateY(0); }
      .email-chip { opacity: 1; transform: translateX(0) !important; }
      .bg-glow-1, .bg-glow-2 { animation: none !important; } 
      .hero h1 { filter: none !important; opacity: 1 !important; transform: none !important; }
      .player-card { opacity: 1 !important; transform: none !important; animation: none !important; }
    }
  </style>
</head>
<body>

  <svg style="display: none;" aria-hidden="true">
    {Object.entries(icons).map(([id, path]) => (
      <symbol id={`icon-${id}`} viewBox="0 0 24 24"><path d={path}></path></symbol>
    ))}
  </svg>

  <div class="bg-system">
    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>
    <canvas id="particleCanvas" class="particle-canvas" aria-hidden="true"></canvas>
    <div class="bg-grid"></div>
    <div class="bg-noise"></div>
  </div>

  <section class="hero">
    <h1>{title}</h1>
    <div class="typewriter-box">
      <span class="hero-sub" id="typewriter"></span><span class="cursor"></span>
    </div>
  </section>

  <main class="container">
    <nav class="nav-list" id="navList" aria-label="个人主页导航矩阵">
      {navData.map(group => (
        <div class="category-section">
          <div class="category-title">{group.category}</div>
          <div class="nav-grid">
            {group.items.map(item => (
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="nav-item vp-glass">
                <div class="nav-left-zone">
                  <svg><use href={`#icon-${item.icon}`}></use></svg>
                  <span>{item.name}</span>
                </div>
                <span class="arrow">→</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </nav>

    <footer class="source-footer">
      <a href="https://github.com/TQSY114514/tqsy" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 16 16" width="13" height="13"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
        <span>Open-source on GitHub</span>
      </a>
    </footer>
  </main>

  <aside class="player-card vp-glass" id="playerCard" aria-label="背景音乐播放器">
    <div class="player-upper">
      <img src={globalIcon} class="album-cover" alt="Miku Cover" width="44" height="44" decoding="async">
      <div class="song-info">
        <div class="song-name">橙交差点</div>
        <div class="song-artist">初音ミク</div>
      </div>
      <button class="play-pause" id="playBtn" aria-label="播放或暂停背景音乐">
        <svg id="icon-play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <svg id="icon-pause" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
      </button>
    </div>
    <div class="player-progress-zone">
      <div class="progress-bar-bg" id="progressContainer">
        <div class="progress-bar-fill" id="progressFill"></div>
      </div>
      <input type="range" id="progressSlider" class="progress-slider" min="0" max="100" value="0" step="0.1" aria-label="音乐进度调整">
      <div class="player-time-labels"><span id="timeCurrent">00:00</span><span id="timeTotal">00:00</span></div>
    </div>
    <audio id="mainAudio" loop preload="metadata"><source src="https://videotourl.com/audio/1775904309738-ed28bd2b-7261-4bb9-8cab-1ed6c1b5b0c9.mp3" type="audio/mpeg"></audio>
  </aside>

  <address class="contact-panel" id="contactPanel">
    <button class="email-chip vp-glass" data-user="tqishengyan" data-host="gmail.com">Loading...</button>
    <button class="email-chip vp-glass" data-user="3635316905" data-host="qq.com">Loading...</button>
    <button class="email-chip vp-glass" data-user="tianqishengyan_zhj" data-host="163.com">Loading...</button>
    <button class="email-chip vp-glass" data-user="tianqishengyan_zhj" data-host="outlook.com">Loading...</button>
  </address>

  <script is:inline>
    const phrases = ["> WEATHER HOLY SALT", "> MIDDLE SCHOOL, WRITES CODE", "> ELECTRON · REACT · TYPESCRIPT", "> OPEN SOURCE & SELF-HOSTING"];
    const typeTarget = document.getElementById('typewriter');
    let phraseIndex = 0; let charIndex = 0; let isDeleting = false;
    const typeLoop = () => {
      const current = phrases[phraseIndex];
      if (isDeleting) { typeTarget.textContent = current.substring(0, charIndex - 1); charIndex--; } 
      else { typeTarget.textContent = current.substring(0, charIndex + 1); charIndex++; }
      let typeSpeed = isDeleting ? 40 : 100;
      if (!isDeleting && charIndex === current.length) { typeSpeed = 2500; isDeleting = true; }
      else if (isDeleting && charIndex === 0) { isDeleting = false; phraseIndex = (phraseIndex + 1) % phrases.length; typeSpeed = 500; }
      setTimeout(typeLoop, typeSpeed);
    };
    if (typeTarget) typeLoop();

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const particleCanvas = document.getElementById('particleCanvas');
    if (particleCanvas && !prefersReducedMotion) {
      const ctx = particleCanvas.getContext('2d');
      const getParticleCount = (w) => w > 768 ? 85 : 30;
      const RADIUS = 2.4; const DIAMETER = RADIUS * 2; const CONNECT_DISTANCE = 145; const BASE_SPEED = 34; 
      const CONNECT_DISTANCE_SQ = CONNECT_DISTANCE * CONNECT_DISTANCE;
      const MOUSE_RADIUS = 120; const MOUSE_FORCE = 400;  

      let width = 0; let height = 0; let dpr = 1;
      let particles = []; let rafId = null; let lastTime = performance.now();
      
      let mouse = { x: -1000, y: -1000 };
      window.addEventListener('mousemove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });
      window.addEventListener('mouseout', () => { mouse.x = -1000; mouse.y = -1000; });

      // ✨ 缓存粒子颜色，仅在初始化与系统深浅色切换时更新，避免 rAF 每帧读取 getComputedStyle
      let cachedParticleColor = 'rgba(120, 120, 128, 0.3)';
      const updateParticleColor = () => {
        cachedParticleColor = getComputedStyle(document.documentElement).getPropertyValue('--particle-theme').trim() || 'rgba(120, 120, 128, 0.3)';
      };
      updateParticleColor();
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateParticleColor);

      const resizeParticles = () => {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = window.innerWidth; height = window.innerHeight;
        particleCanvas.width = Math.floor(width * dpr);
        particleCanvas.height = Math.floor(height * dpr);
        particleCanvas.style.width = `${width}px`;
        particleCanvas.style.height = `${height}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const targetCount = getParticleCount(width);
        if (particles.length === 0) {
          particles = Array.from({ length: targetCount }, () => {
            const angle = Math.random() * Math.PI * 2;
            return { x: RADIUS + Math.random() * (width - DIAMETER), y: RADIUS + Math.random() * (height - DIAMETER), vx: Math.cos(angle) * BASE_SPEED, vy: Math.sin(angle) * BASE_SPEED };
          });
        } else if (particles.length < targetCount) {
          const newParticles = Array.from({ length: targetCount - particles.length }, () => {
            const angle = Math.random() * Math.PI * 2;
            return { x: RADIUS + Math.random() * (width - DIAMETER), y: RADIUS + Math.random() * (height - DIAMETER), vx: Math.cos(angle) * BASE_SPEED, vy: Math.sin(angle) * BASE_SPEED };
          });
          particles = particles.concat(newParticles);
        } else if (particles.length > targetCount) {
          particles = particles.slice(0, targetCount);
        }
      };

      const stepParticles = (now) => {
        const dt = Math.min((now - lastTime) / 1000, 0.033);
        lastTime = now;
        ctx.clearRect(0, 0, width, height);

        for (const particle of particles) {
          const dx = particle.x - mouse.x; const dy = particle.y - mouse.y; const dist = Math.hypot(dx, dy);
          if (dist < MOUSE_RADIUS && dist > 0) {
            const force = (MOUSE_RADIUS - dist) / MOUSE_RADIUS; 
            particle.vx += (dx / dist) * force * MOUSE_FORCE * dt; particle.vy += (dy / dist) * force * MOUSE_FORCE * dt;
          }
          particle.x += particle.vx * dt; particle.y += particle.vy * dt;
          if (particle.x <= RADIUS) { particle.x = RADIUS; particle.vx *= -1; } else if (particle.x >= width - RADIUS) { particle.x = width - RADIUS; particle.vx *= -1; }
          if (particle.y <= RADIUS) { particle.y = RADIUS; particle.vy *= -1; } else if (particle.y >= height - RADIUS) { particle.y = height - RADIUS; particle.vy *= -1; }

          const currentSpeed = Math.hypot(particle.vx, particle.vy);
          if (currentSpeed > 0) {
            const newSpeed = currentSpeed + (BASE_SPEED - currentSpeed) * 0.05;
            particle.vx = (particle.vx / currentSpeed) * newSpeed; particle.vy = (particle.vy / currentSpeed) * newSpeed;
          }
        }

        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const a = particles[i]; const b = particles[j];
            const dx = a.x - b.x; const dy = a.y - b.y;
            const distSq = dx * dx + dy * dy;
            if (distSq < CONNECT_DISTANCE_SQ) {
              const dist = Math.sqrt(distSq);
              const strength = 1 - dist / CONNECT_DISTANCE;
              ctx.globalAlpha = strength * 0.75; ctx.strokeStyle = cachedParticleColor; ctx.lineWidth = Math.min(DIAMETER, 1.4 * strength);
              ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
            }
          }
        }

        ctx.globalAlpha = 1; ctx.fillStyle = cachedParticleColor;
        for (const particle of particles) { ctx.beginPath(); ctx.arc(particle.x, particle.y, RADIUS, 0, Math.PI * 2); ctx.fill(); }
        rafId = requestAnimationFrame(stepParticles);
      };

      resizeParticles();
      
      let resizeTimeout;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(resizeParticles, 150);
      }, { passive: true });
      
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) { cancelAnimationFrame(rafId); } else { lastTime = performance.now(); rafId = requestAnimationFrame(stepParticles); }
      });
      rafId = requestAnimationFrame(stepParticles);
    }

    const items = document.querySelectorAll('.nav-item, .category-title');
    const itemsArray = Array.from(items); 
    let staggerDelay = 0; let resetTimer = null;
    const observer = new IntersectionObserver((entries) => {
      const visibleEntries = entries.filter(entry => entry.isIntersecting || entry.boundingClientRect.top < window.innerHeight);
      if (visibleEntries.length === 0) return;
      visibleEntries.sort((a, b) => itemsArray.indexOf(a.target) - itemsArray.indexOf(b.target));
      visibleEntries.forEach((entry) => {
        if (!entry.target.classList.contains('show')) {
          if (prefersReducedMotion) entry.target.classList.add('show');
          else { setTimeout(() => { entry.target.classList.add('show'); }, staggerDelay); staggerDelay += 80; }
          observer.unobserve(entry.target);
        }
      });
      if (!prefersReducedMotion) { clearTimeout(resetTimer); resetTimer = setTimeout(() => { staggerDelay = 0; }, 300); }
    }, { threshold: 0, rootMargin: "0px 0px -50px 0px" });
    items.forEach(item => observer.observe(item));

    const audio = document.getElementById('mainAudio');
    const playBtn = document.getElementById('playBtn');
    const playerCard = document.getElementById('playerCard');
    const progressFill = document.getElementById('progressFill');
    const progressSlider = document.getElementById('progressSlider');
    const timeCurrent = document.getElementById('timeCurrent');
    const timeTotal = document.getElementById('timeTotal');
    let audioRafId;

    const formatTime = (secs) => {
      if (isNaN(secs) || !isFinite(secs)) return "00:00";
      return `${Math.floor(secs / 60).toString().padStart(2, '0')}:${Math.floor(secs % 60).toString().padStart(2, '0')}`;
    };

    const updateAudioProgress = () => {
      if (!audio.paused && audio.duration) {
        const percent = (audio.currentTime / audio.duration) * 100;
        progressFill.style.width = `${percent}%`;
        progressSlider.value = percent;
        timeCurrent.textContent = formatTime(audio.currentTime);
      }
      audioRafId = requestAnimationFrame(updateAudioProgress);
    };

    const setupMediaSession = () => {
      if ('mediaSession' in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({ title: '橙交差点', artist: '初音ミク', album: 'Miku Symphony', artwork: [{ src: 'https://files.catbox.moe/vui2ub.jpg', sizes: '512x512', type: 'image/jpeg' }] });
        navigator.mediaSession.setActionHandler('play', () => { if (audio.paused) playBtn.click(); });
        navigator.mediaSession.setActionHandler('pause', () => { if (!audio.paused) playBtn.click(); });
      }
    };

    playBtn.onclick = (e) => {
      e.stopPropagation();
      if (audio.paused) {
        audio.play().then(() => { setupMediaSession(); }).catch(() => console.warn('Audio play intercepted.'));
        playerCard.classList.add('is-playing');
        audioRafId = requestAnimationFrame(updateAudioProgress);
      } else {
        audio.pause(); playerCard.classList.remove('is-playing'); cancelAnimationFrame(audioRafId);
      }
    };

    let metadataTimeout;
    const initAudioDuration = () => {
      clearTimeout(metadataTimeout);
      if (audio.duration && !isNaN(audio.duration)) {
        timeTotal.textContent = formatTime(audio.duration);
        const savedTime = localStorage.getItem('tqsy:v1:audioTime');
        if (savedTime && !isNaN(savedTime)) {
          audio.currentTime = parseFloat(savedTime);
          timeCurrent.textContent = formatTime(audio.currentTime);
          progressFill.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
          progressSlider.value = (audio.currentTime / audio.duration) * 100;
        }
      }
    };
    
    audio.addEventListener('timeupdate', () => {
      if (audio.currentTime > 0) localStorage.setItem('tqsy:v1:audioTime', audio.currentTime);
    });

    if (audio.readyState >= 1) {
      initAudioDuration();
    } else {
      audio.addEventListener('loadedmetadata', initAudioDuration);
      metadataTimeout = setTimeout(() => { timeTotal.textContent = "00:00"; }, 3000);
    }

    progressSlider.addEventListener('input', (e) => {
      if (!audio.duration) return;
      const val = parseFloat(e.target.value);
      audio.currentTime = (val / 100) * audio.duration;
      progressFill.style.width = `${val}%`;
      timeCurrent.textContent = formatTime(audio.currentTime);
    });

    window.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.altKey || e.metaKey) return;
      if (['A', 'BUTTON', 'INPUT'].includes(document.activeElement?.tagName)) return;
      
      switch (e.code) {
        case 'Space':
          e.preventDefault();
          playBtn.click();
          break;
        case 'ArrowRight':
          e.preventDefault();
          if (audio.duration) {
            audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
            if (audio.paused) {
               const percent = (audio.currentTime / audio.duration) * 100;
               progressFill.style.width = `${percent}%`;
               progressSlider.value = percent;
               timeCurrent.textContent = formatTime(audio.currentTime);
            }
          }
          break;
        case 'ArrowLeft':
          e.preventDefault();
          if (audio.duration) {
            audio.currentTime = Math.max(0, audio.currentTime - 5);
            if (audio.paused) {
               const percent = (audio.currentTime / audio.duration) * 100;
               progressFill.style.width = `${percent}%`;
               progressSlider.value = percent;
               timeCurrent.textContent = formatTime(audio.currentTime);
            }
          }
          break;
      }
    });

    const emailChips = document.querySelectorAll('.email-chip');
    emailChips.forEach(chip => {
      const realEmail = `${chip.getAttribute('data-user')}@${chip.getAttribute('data-host')}`;
      chip.textContent = realEmail;
      chip.setAttribute('data-ready', 'true');
      
      let isCopying = false;
      chip.onclick = (e) => { 
        e.preventDefault(); 
        if(isCopying) return;
        if (navigator.vibrate) navigator.vibrate(30);

        navigator.clipboard.writeText(realEmail).then(() => {
          isCopying = true;
          const originalText = chip.textContent;
          chip.innerHTML = `<span style="color: var(--miku-green); font-weight: bold;">✨ 复制成功</span>`;
          setTimeout(() => { chip.textContent = originalText; isCopying = false; }, 2000);
        }).catch(err => {
          window.location.href = `mailto:${realEmail}`; 
        });
      };
    });

    const updateScrollProgress = () => {
      const maxScroll = document.body.offsetHeight - window.innerHeight;
      if (maxScroll <= 0) {
        emailChips.forEach(chip => { chip.style.setProperty('--chip-x', '0px'); chip.style.setProperty('--chip-op', '1'); });
        document.body.classList.add('is-bottom'); return;
      }
      const triggerZone = 250;
      let progress = Math.max(0, Math.min(1, (window.scrollY - (maxScroll - triggerZone)) / triggerZone));
      document.body.classList.toggle('is-bottom', progress > 0);

      emailChips.forEach((chip, index) => {
        if (prefersReducedMotion) { chip.style.setProperty('--chip-x', '0px'); chip.style.setProperty('--chip-op', '1'); return; }
        const easeOut = 1 - Math.pow(1 - Math.max(0, Math.min(1, Math.max(0, progress - index * 0.15) / 0.55)), 2);
        chip.style.setProperty('--chip-x', `${40 * (1 - easeOut)}px`); chip.style.setProperty('--chip-op', easeOut);
      });
    };
    window.addEventListener('scroll', updateScrollProgress, { passive: true });
    window.addEventListener('resize', updateScrollProgress, { passive: true });
    updateScrollProgress(); 
  </script>
</body>
</html>
