  <script is:inline>
    const phrases = ["> WEATHER HOLY SALT", "> CYBER DEVELOPER", "> ACG ENTHUSIAST", "> GAMER"];
    const typeTarget = document.getElementById('typewriter');
    let phraseIndex = 0; let charIndex = 0; let isDeleting = false;
    const typeLoop = () => {
      const current = phrases[phraseIndex];
      if (isDeleting) { typeTarget.textContent = current.substring(0, charIndex - 1); charIndex--; } 
      else { typeTarget.textContent = current.substring(0, charIndex + 1); charIndex++; }
      let typeSpeed = isDeleting ? 40 : 100;
      if (!isDeleting && charIndex === current.length) { typeSpeed = 2500; isDeleting = true; }
      else if (isDeleting && charIndex === 0) { isDeleting = false; phraseIndex = (phraseIndex + 1) % phrases.length; typeSpeed = 500; }
      setTimeout(typeLoop, typeSpeed);
    };
    if (typeTarget) typeLoop();

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idleTimer;
    const resetIdleTimer = () => {
      document.body.classList.remove('is-idle');
      clearTimeout(idleTimer);
      if (!prefersReducedMotion) idleTimer = setTimeout(() => { document.body.classList.add('is-idle'); }, 5000); 
    };
    ['mousemove', 'mousedown', 'keydown', 'touchstart', 'scroll'].forEach(evt => window.addEventListener(evt, resetIdleTimer, { passive: true }));
    resetIdleTimer();

    const particleCanvas = document.getElementById('particleCanvas');
    if (particleCanvas && !prefersReducedMotion) {
      const ctx = particleCanvas.getContext('2d');
      const getParticleCount = (w) => w > 768 ? 85 : 30;
      const RADIUS = 2.4; const DIAMETER = RADIUS * 2; const CONNECT_DISTANCE = 145; const BASE_SPEED = 34; 
      const MOUSE_RADIUS = 120; const MOUSE_FORCE = 400;  

      let width = 0; let height = 0; let dpr = 1;
      let particles = []; let rafId = null; let lastTime = performance.now();
      
      let mouse = { x: -1000, y: -1000 };
      window.addEventListener('mousemove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });
      window.addEventListener('mouseout', () => { mouse.x = -1000; mouse.y = -1000; });

      const getParticleColor = () => getComputedStyle(document.documentElement).getPropertyValue('--particle-theme').trim() || 'rgba(120, 120, 128, 0.3)';

      const resizeParticles = () => {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = window.innerWidth; height = window.innerHeight;
        particleCanvas.width = Math.floor(width * dpr);
        particleCanvas.height = Math.floor(height * dpr);
        particleCanvas.style.width = `${width}px`;
        particleCanvas.style.height = `${height}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const targetCount = getParticleCount(width);
        if (particles.length === 0) {
          particles = Array.from({ length: targetCount }, () => {
            const angle = Math.random() * Math.PI * 2;
            return { x: RADIUS + Math.random() * (width - DIAMETER), y: RADIUS + Math.random() * (height - DIAMETER), vx: Math.cos(angle) * BASE_SPEED, vy: Math.sin(angle) * BASE_SPEED };
          });
        } else if (particles.length < targetCount) {
          const newParticles = Array.from({ length: targetCount - particles.length }, () => {
            const angle = Math.random() * Math.PI * 2;
            return { x: RADIUS + Math.random() * (width - DIAMETER), y: RADIUS + Math.random() * (height - DIAMETER), vx: Math.cos(angle) * BASE_SPEED, vy: Math.sin(angle) * BASE_SPEED };
          });
          particles = particles.concat(newParticles);
        } else if (particles.length > targetCount) {
          particles = particles.slice(0, targetCount);
        }
      };

      const stepParticles = (now) => {
        const dt = Math.min((now - lastTime) / 1000, 0.033);
        lastTime = now;
        ctx.clearRect(0, 0, width, height);
        const color = getParticleColor();

        for (const particle of particles) {
          const dx = particle.x - mouse.x; const dy = particle.y - mouse.y; const dist = Math.hypot(dx, dy);
          if (dist < MOUSE_RADIUS && dist > 0) {
            const force = (MOUSE_RADIUS - dist) / MOUSE_RADIUS; 
            particle.vx += (dx / dist) * force * MOUSE_FORCE * dt; particle.vy += (dy / dist) * force * MOUSE_FORCE * dt;
          }
          particle.x += particle.vx * dt; particle.y += particle.vy * dt;
          if (particle.x <= RADIUS) { particle.x = RADIUS; particle.vx *= -1; } else if (particle.x >= width - RADIUS) { particle.x = width - RADIUS; particle.vx *= -1; }
          if (particle.y <= RADIUS) { particle.y = RADIUS; particle.vy *= -1; } else if (particle.y >= height - RADIUS) { particle.y = height - RADIUS; particle.vy *= -1; }

          const currentSpeed = Math.hypot(particle.vx, particle.vy);
          if (currentSpeed > 0) {
            const newSpeed = currentSpeed + (BASE_SPEED - currentSpeed) * 0.05;
            particle.vx = (particle.vx / currentSpeed) * newSpeed; particle.vy = (particle.vy / currentSpeed) * newSpeed;
          }
        }

        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const a = particles[i]; const b = particles[j]; const dist = Math.hypot(a.x - b.x, a.y - b.y);
            if (dist < CONNECT_DISTANCE) {
              const strength = 1 - dist / CONNECT_DISTANCE;
              ctx.globalAlpha = strength * 0.75; ctx.strokeStyle = color; ctx.lineWidth = Math.min(DIAMETER, 1.4 * strength);
              ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
            }
          }
        }

        ctx.globalAlpha = 1; ctx.fillStyle = color;
        for (const particle of particles) { ctx.beginPath(); ctx.arc(particle.x, particle.y, RADIUS, 0, Math.PI * 2); ctx.fill(); }
        rafId = requestAnimationFrame(stepParticles);
      };

      resizeParticles();
      
      // ✨ 2. 加入 Resize 防抖，防止调整窗口时 Canvas 重绘导致掉帧卡死
      let resizeTimeout;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(resizeParticles, 150);
      }, { passive: true });
      
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) { cancelAnimationFrame(rafId); } else { lastTime = performance.now(); rafId = requestAnimationFrame(stepParticles); }
      });
      rafId = requestAnimationFrame(stepParticles);
    }

    const items = document.querySelectorAll('.nav-item, .category-title');
    const itemsArray = Array.from(items); 
    let staggerDelay = 0; let resetTimer = null;
    const observer = new IntersectionObserver((entries) => {
      const visibleEntries = entries.filter(entry => entry.isIntersecting || entry.boundingClientRect.top < window.innerHeight);
      if (visibleEntries.length === 0) return;
      visibleEntries.sort((a, b) => itemsArray.indexOf(a.target) - itemsArray.indexOf(b.target));
      visibleEntries.forEach((entry) => {
        if (!entry.target.classList.contains('show')) {
          if (prefersReducedMotion) entry.target.classList.add('show');
          else { setTimeout(() => { entry.target.classList.add('show'); }, staggerDelay); staggerDelay += 80; }
          observer.unobserve(entry.target);
        }
      });
      if (!prefersReducedMotion) { clearTimeout(resetTimer); resetTimer = setTimeout(() => { staggerDelay = 0; }, 300); }
    }, { threshold: 0, rootMargin: "0px 0px -50px 0px" });
    items.forEach(item => observer.observe(item));

    const audio = document.getElementById('mainAudio');
    const playBtn = document.getElementById('playBtn');
    const playerCard = document.getElementById('playerCard');
    const progressFill = document.getElementById('progressFill');
    const progressSlider = document.getElementById('progressSlider');
    const timeCurrent = document.getElementById('timeCurrent');
    const timeTotal = document.getElementById('timeTotal');
    let audioRafId;

    const formatTime = (secs) => {
      if (isNaN(secs) || !isFinite(secs)) return "00:00";
      return `${Math.floor(secs / 60).toString().padStart(2, '0')}:${Math.floor(secs % 60).toString().padStart(2, '0')}`;
    };

    const updateAudioProgress = () => {
      if (!audio.paused && audio.duration) {
        const percent = (audio.currentTime / audio.duration) * 100;
        progressFill.style.width = `${percent}%`;
        progressSlider.value = percent;
        timeCurrent.textContent = formatTime(audio.currentTime);
      }
      audioRafId = requestAnimationFrame(updateAudioProgress);
    };

    const setupMediaSession = () => {
      if ('mediaSession' in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({ title: '橙交差点', artist: '初音ミク', album: 'Miku Symphony', artwork: [{ src: 'https://cdn.phototourl.com/free/2026-04-11-eee19110-0750-4557-be87-830a17b948b5.jpg', sizes: '512x512', type: 'image/jpeg' }] });
        navigator.mediaSession.setActionHandler('play', () => { if (audio.paused) playBtn.click(); });
        navigator.mediaSession.setActionHandler('pause', () => { if (!audio.paused) playBtn.click(); });
      }
    };

    playBtn.onclick = (e) => {
      e.stopPropagation();
      if (audio.paused) {
        audio.play().then(() => { setupMediaSession(); }).catch(() => console.warn('Audio play intercepted.'));
        playerCard.classList.add('is-playing');
        audioRafId = requestAnimationFrame(updateAudioProgress);
      } else {
        audio.pause(); playerCard.classList.remove('is-playing'); cancelAnimationFrame(audioRafId);
      }
    };

    // ✨ Audio Metadata 超时兜底处理
    let metadataTimeout;
    const initAudioDuration = () => {
      clearTimeout(metadataTimeout);
      if (audio.duration && !isNaN(audio.duration)) {
        timeTotal.textContent = formatTime(audio.duration);
        // ✨ 本地存储键值规范化
        const savedTime = localStorage.getItem('tqsy:v1:audioTime');
        if (savedTime && !isNaN(savedTime)) {
          audio.currentTime = parseFloat(savedTime);
          timeCurrent.textContent = formatTime(audio.currentTime);
          progressFill.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
          progressSlider.value = (audio.currentTime / audio.duration) * 100;
        }
      }
    };
    
    audio.addEventListener('timeupdate', () => {
      if (audio.currentTime > 0) localStorage.setItem('tqsy:v1:audioTime', audio.currentTime);
    });

    if (audio.readyState >= 1) {
      initAudioDuration();
    } else {
      audio.addEventListener('loadedmetadata', initAudioDuration);
      metadataTimeout = setTimeout(() => { timeTotal.textContent = "00:00"; }, 3000);
    }

    // ✨ a11y: 结合原生 range 交互逻辑
    progressSlider.addEventListener('input', (e) => {
      if (!audio.duration) return;
      const val = parseFloat(e.target.value);
      audio.currentTime = (val / 100) * audio.duration;
      progressFill.style.width = `${val}%`;
      timeCurrent.textContent = formatTime(audio.currentTime);
    });

    // ✨ 7. 极客专属：全局键盘媒体控制 (Global Media Shortcuts)
    window.addEventListener('keydown', (e) => {
      // 忽略辅助按键组合，避免和系统快捷键冲突
      if (e.ctrlKey || e.altKey || e.metaKey) return;
      
      switch (e.code) {
        case 'Space':
          e.preventDefault(); // 阻止空格键默认向下滚动网页的行径
          playBtn.click();
          break;
        case 'ArrowRight':
          e.preventDefault(); // 阻止页面原生横向滚动
          if (audio.duration) {
            audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
            // 如果是在暂停状态下快进，手动刷新一下 UI
            if (audio.paused) {
               const percent = (audio.currentTime / audio.duration) * 100;
               progressFill.style.width = `${percent}%`;
               progressSlider.value = percent;
               timeCurrent.textContent = formatTime(audio.currentTime);
            }
          }
          break;
        case 'ArrowLeft':
          e.preventDefault();
          if (audio.duration) {
            audio.currentTime = Math.max(0, audio.currentTime - 5);
            if (audio.paused) {
               const percent = (audio.currentTime / audio.duration) * 100;
               progressFill.style.width = `${percent}%`;
               progressSlider.value = percent;
               timeCurrent.textContent = formatTime(audio.currentTime);
            }
          }
          break;
      }
    });

    const emailChips = document.querySelectorAll('.email-chip');
    emailChips.forEach(chip => {
      const realEmail = `${chip.getAttribute('data-user')}@${chip.getAttribute('data-host')}`;
      chip.textContent = realEmail;
      chip.setAttribute('data-ready', 'true'); // ✨ 赋予就绪标识，防止 Loading 闪烁
      
      let isCopying = false;
      chip.onclick = (e) => { 
        e.preventDefault(); 
        if(isCopying) return;
        if (navigator.vibrate) navigator.vibrate(30);

        navigator.clipboard.writeText(realEmail).then(() => {
          isCopying = true;
          const originalText = chip.textContent;
          chip.innerHTML = `<span style="color: var(--miku-green); font-weight: bold;">✨ 复制成功</span>`;
          setTimeout(() => { chip.textContent = originalText; isCopying = false; }, 2000);
        }).catch(err => {
          window.location.href = `mailto:${realEmail}`; 
        });
      };
    });

    const updateScrollProgress = () => {
      const maxScroll = document.body.offsetHeight - window.innerHeight;
      if (maxScroll <= 0) {
        emailChips.forEach(chip => { chip.style.setProperty('--chip-x', '0px'); chip.style.setProperty('--chip-op', '1'); });
        document.body.classList.add('is-bottom'); return;
      }
      const triggerZone = 250;
      let progress = Math.max(0, Math.min(1, (window.scrollY - (maxScroll - triggerZone)) / triggerZone));
      document.body.classList.toggle('is-bottom', progress > 0);

      emailChips.forEach((chip, index) => {
        if (prefersReducedMotion) { chip.style.setProperty('--chip-x', '0px'); chip.style.setProperty('--chip-op', '1'); return; }
        const easeOut = 1 - Math.pow(1 - Math.max(0, Math.min(1, Math.max(0, progress - index * 0.15) / 0.55)), 2);
        chip.style.setProperty('--chip-x', `${40 * (1 - easeOut)}px`); chip.style.setProperty('--chip-op', easeOut);
      });
    };
    window.addEventListener('scroll', updateScrollProgress, { passive: true });
    window.addEventListener('resize', updateScrollProgress, { passive: true });
    updateScrollProgress(); 
  </script>
</body>
</html>
