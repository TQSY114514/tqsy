  <script is:inline>
    // 1. 静止态管理系统
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idleTimer;
    const resetIdleTimer = () => {
      document.body.classList.remove('is-idle');
      clearTimeout(idleTimer);
      if (!prefersReducedMotion) {
        idleTimer = setTimeout(() => { document.body.classList.add('is-idle'); }, 5000); 
      }
    };
    ['mousemove', 'mousedown', 'keydown', 'touchstart', 'scroll'].forEach(evt => 
      window.addEventListener(evt, resetIdleTimer, { passive: true })
    );
    resetIdleTimer();

    // 2. 物理防跳帧流式揭示逻辑
    const items = document.querySelectorAll('.nav-item, .category-title');
    const itemsArray = Array.from(items); 
    let staggerDelay = 0;
    let resetTimer = null;

    const observer = new IntersectionObserver((entries) => {
      const visibleEntries = entries.filter(entry => 
        entry.isIntersecting || entry.boundingClientRect.top < window.innerHeight
      );
      if (visibleEntries.length === 0) return;

      visibleEntries.sort((a, b) => itemsArray.indexOf(a.target) - itemsArray.indexOf(b.target));

      visibleEntries.forEach((entry) => {
        if (!entry.target.classList.contains('show')) {
          if (prefersReducedMotion) {
            entry.target.classList.add('show');
          } else {
            setTimeout(() => { entry.target.classList.add('show'); }, staggerDelay);
            staggerDelay += 80; 
          }
          observer.unobserve(entry.target);
        }
      });

      if (!prefersReducedMotion) {
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => { staggerDelay = 0; }, 300);
      }
    }, { threshold: 0, rootMargin: "0px 0px -50px 0px" });
    items.forEach(item => observer.observe(item));

    // 3. 强化版音频控制及高精进度条监听
    const audio = document.getElementById('mainAudio');
    const playBtn = document.getElementById('playBtn');
    const playerCard = document.getElementById('playerCard');
    const progressFill = document.getElementById('progressFill');
    const timeCurrent = document.getElementById('timeCurrent');
    const timeTotal = document.getElementById('timeTotal');
    const progressContainer = document.getElementById('progressContainer');

    // 格式化时间戳 (00:00)
    const formatTime = (secs) => {
      if (isNaN(secs)) return "00:00";
      const m = Math.floor(secs / 60).toString().padStart(2, '0');
      const s = Math.floor(secs % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    };

    playBtn.onclick = (e) => {
      e.stopPropagation();
      if (audio.paused) {
        audio.play().then(() => { playerCard.classList.add('is-playing'); });
      } else {
        audio.pause();
        playerCard.classList.remove('is-playing');
      }
    };

    // 元数据加载完成时，立刻抓取音频精准总长
    audio.addEventListener('loadedmetadata', () => {
      timeTotal.textContent = formatTime(audio.duration);
    });

    // 播放时间轴高精同步 (每秒刷新多帧保证丝滑)
    audio.addEventListener('timeupdate', () => {
      if (!audio.duration) return;
      const pct = (audio.currentTime / audio.duration) * 100;
      progressFill.style.width = `${pct}%`;
      timeCurrent.textContent = formatTime(audio.currentTime);
    });

    // 支持点击进度条物理“跃迁”调准时间
    progressContainer.onclick = (e) => {
      const rect = progressContainer.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const width = rect.width;
      const newTime = (clickX / width) * audio.duration;
      audio.currentTime = newTime;
    };

    // 4. ✨ 物理加密：防爬虫动态拼接邮件模组
    const emailChips = document.querySelectorAll('.email-chip');
    
    emailChips.forEach(chip => {
      const u = chip.getAttribute('data-user');
      const h = chip.getAttribute('data-host');
      const realEmail = `${u}@${h}`;
      
      // 网页上只显示混淆字样，彻底隔绝源码静态爬虫
      chip.textContent = realEmail;

      // 只有在人类真正触发点击时，才会现场激活 mailto 路由
      chip.onclick = (e) => {
        e.preventDefault();
        window.location.href = `mailto:${realEmail}`;
      };
    });

    // 5. 滚动绑定算法 (Scrubbing)
    const updateScrollProgress = () => {
      const maxScroll = document.body.offsetHeight - window.innerHeight;
      
      if (maxScroll <= 0) {
        emailChips.forEach(chip => {
          chip.style.setProperty('--chip-x', '0px');
          chip.style.setProperty('--chip-op', '1');
        });
        document.body.classList.add('is-bottom');
        return;
      }

      const triggerZone = 250;
      const startScroll = maxScroll - triggerZone;
      const currentScroll = window.scrollY;

      let progress = 0;
      if (currentScroll >= startScroll) {
        progress = (currentScroll - startScroll) / triggerZone;
      }
      progress = Math.max(0, Math.min(1, progress));

      document.body.classList.toggle('is-bottom', progress > 0);

      emailChips.forEach((chip, index) => {
        if (prefersReducedMotion) {
          chip.style.setProperty('--chip-x', '0px');
          chip.style.setProperty('--chip-op', '1');
          return;
        }

        const stagger = 0.15;
        const delay = index * stagger;
        
        let chipProgress = Math.max(0, progress - delay) / (1 - stagger * 3);
        chipProgress = Math.max(0, Math.min(1, chipProgress));

        const easeOut = 1 - Math.pow(1 - chipProgress, 2);

        chip.style.setProperty('--chip-x', `${40 * (1 - easeOut)}px`);
        chip.style.setProperty('--chip-op', easeOut);
      });
    };

    window.addEventListener('scroll', updateScrollProgress, { passive: true });
    window.addEventListener('resize', updateScrollProgress, { passive: true });
    updateScrollProgress(); 

  </script>
