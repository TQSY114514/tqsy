  <style>
    :root {
      --miku-green: #00cfb5;
      --miku-blue: #00a3e0;
      --bg-white: #fcfcfc;
      --text-dark: #1d1d1f;
      --text-gray: #86868b;
      
      --vp-glass: linear-gradient(135deg, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0.05));
      --vp-glass-border: rgba(255, 255, 255, 0.15);
      --vp-glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
      --glass-hover: rgba(0, 207, 181, 0.08);
      
      --ease: cubic-bezier(0.16, 1, 0.3, 1);
      --dot-color: rgba(0, 0, 0, 0.03);
      --noise-opacity: 0.015;
      --particle-theme: rgba(80, 130, 120, 0.25); 
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg-white: #0a0a0c;
        --text-dark: #f5f5f7;
        --text-gray: #a1a1a6;
        
        --vp-glass: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
        --vp-glass-border: rgba(255, 255, 255, 0.08);
        --vp-glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        --glass-hover: rgba(0, 207, 181, 0.15);
        
        --dot-color: rgba(255, 255, 255, 0.02);
        --noise-opacity: 0.025;
        --particle-theme: rgba(160, 210, 200, 0.2);
      }
    }

    /* ✨ 3. a11y: 全局无障碍焦点光环 */
    *:focus-visible { outline: 2px solid var(--miku-green); outline-offset: 4px; border-radius: inherit; }
    ::selection { background-color: var(--miku-green); color: #ffffff; }

    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; }
    ::-webkit-scrollbar { width: 0px; height: 0px; }

    body { 
      background-color: var(--bg-white); color: var(--text-dark); 
      font-family: -apple-system, BlinkMacSystemFont, system-ui, "Segoe UI", Roboto, "SF Pro Text", sans-serif; 
      overflow-x: hidden;
      transition: background-color 0.5s var(--ease), color 0.5s var(--ease);
    }

    .bg-system { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; pointer-events: none; }
    
    .bg-glow-1 { 
      position: absolute; top: -20%; right: -20%; width: 80vmax; height: 80vmax; 
      background: radial-gradient(closest-side, rgba(0, 207, 181, 0.15) 0%, rgba(0, 207, 181, 0) 100%); 
    }
    .bg-glow-2 { 
      position: absolute; bottom: -20%; left: -20%; width: 80vmax; height: 80vmax;
      background: radial-gradient(closest-side, rgba(0, 163, 224, 0.12) 0%, rgba(0, 163, 224, 0) 100%); 
    }
    .particle-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
    
    .bg-grid {
      position: absolute; inset: 0; background-image: radial-gradient(var(--dot-color) 1px, transparent 1px); background-size: 24px 24px;
    }
    .bg-noise {
      position: absolute; inset: 0; opacity: var(--noise-opacity);
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    }

    @keyframes aurora-1 { 0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.7; } 50% { transform: translate(-5%, 5%) scale(1.1); opacity: 1; } }
    @keyframes aurora-2 { 0%, 100% { transform: translate(0, 0) scale(1.1); opacity: 1; } 50% { transform: translate(5%, -5%) scale(0.9); opacity: 0.6; } }
    body.is-idle .bg-glow-1 { animation: aurora-1 10s infinite ease-in-out; }
    body.is-idle .bg-glow-2 { animation: aurora-2 12s infinite ease-in-out; }

    /* ✨ 4. 优化呼吸态：降低模糊度，避免页面坏掉的错觉 */
    @media (hover: hover) { body.is-idle .nav-list:hover .nav-item { opacity: 1; filter: blur(0); } body.is-idle .nav-list:hover .category-title { opacity: 0.8; } }

    .hero { height: 100dvh; display: flex; flex-direction: column; justify-content: center; align-items: center; user-select: none; -webkit-user-select: none; }

    .hero h1 { 
      font-size: clamp(3.2rem, 10vw, 6.5rem); font-weight: 800; 
      background: linear-gradient(var(--text-dark), var(--text-gray)); 
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; 
      animation: titleReveal 1.2s var(--ease) 0.1s both;
      line-height: 1.1; margin-bottom: 12px;
    }
    @keyframes titleReveal { 0% { opacity: 0; filter: blur(12px); transform: translateY(15px); } 100% { opacity: 1; filter: blur(0); transform: translateY(0); } }
    
    .typewriter-box { display: flex; align-items: center; justify-content: center; height: 20px; opacity: 0; animation: titleReveal 1s var(--ease) 0.5s both; }
    .hero-sub { color: var(--text-gray); letter-spacing: 0.15em; text-transform: uppercase; font-size: 0.85rem; font-family: monospace; font-weight: 600; }
    /* ✨ 5. 打字机光标单位优化为 ch */
    .cursor { display: inline-block; width: 1ch; height: 1.1em; background-color: var(--miku-green); margin-left: 6px; animation: blink 1s step-end infinite; }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

    .container { max-width: 580px; margin: 0 auto; padding: 0 20px 250px 20px; }

    .category-title {
      font-size: 11px; font-weight: 700; color: var(--text-gray); letter-spacing: 0.25em; text-transform: uppercase;
      margin: 40px 0 16px 12px; opacity: 0; transform: translateY(20px);
      transition: opacity 0.8s var(--ease), transform 0.8s var(--ease), opacity 1.5s ease-in-out;
    }
    .category-title.show { opacity: 0.8; transform: translateY(0); }
    body.is-idle .category-title { opacity: 0.3; }

    .nav-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 8px; }
    .nav-grid > .nav-item:last-child:nth-child(odd) { grid-column: span 2; }

    .vp-glass {
      background: var(--vp-glass); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--vp-glass-border); box-shadow: var(--vp-glass-shadow);
    }

    /* ✨ 2. 移除常驻 will-change，转移到悬停状态 */
    .nav-item { 
      display: flex; align-items: center; justify-content: space-between; 
      padding: 20px 24px; border-radius: 24px; text-decoration: none; 
      color: var(--text-dark); font-weight: 600; opacity: 0; transform: translateY(30px);
      transition: opacity 0.8s var(--ease), transform 0.8s var(--ease), border-color 0.4s var(--ease), box-shadow 0.4s var(--ease), background-color 0.5s var(--ease), filter 1.5s ease-in-out;
      user-select: none; -webkit-user-select: none; height: 100%;
    }
    .nav-item:hover, .nav-item:active { will-change: transform, opacity; }
    
    .nav-left-zone { display: flex; align-items: center; gap: 14px; }
    .nav-item svg { width: 18px; height: 18px; fill: currentColor; flex-shrink: 0; transition: transform 0.4s var(--ease); }
    .nav-item span { transition: color 0.4s var(--ease); }
    .nav-item .arrow { color: var(--text-gray); opacity: 0.6; font-family: monospace; }
    .nav-item.show { opacity: 1; transform: translateY(0); }
    
    @media (hover: hover) {
      .nav-item.show:hover { transform: translateY(-4px); border-color: var(--miku-green); box-shadow: 0 10px 40px rgba(0,207,181,0.15); }
      .nav-item.show:hover span { color: var(--miku-green); }
      .nav-item.show:hover svg { transform: scale(1.1); color: var(--miku-green); }
    }
    .nav-item.show:active { transform: scale(0.97); background: var(--glass-hover); transition: transform 0.1s, background 0.1s; }
    body.is-idle .nav-item { opacity: 0.5; filter: blur(1px); }

    .source-footer { text-align: center; margin-top: 60px; opacity: 0; animation: fadeIn 1.5s var(--ease) 1s forwards; }
    @keyframes fadeIn { to { opacity: 1; } }
    .source-footer a { display: inline-flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--text-gray); text-decoration: none; letter-spacing: 0.05em; transition: color 0.3s var(--ease), opacity 0.3s var(--ease); user-select: none; -webkit-user-select: none; opacity: 0.6; }
    .source-footer svg { width: 13px; height: 13px; fill: currentColor; }
    @media (hover: hover) { .source-footer a:hover { color: var(--miku-green); opacity: 1; } }

    .player-card { 
      position: fixed; left: 25px; bottom: 25px; width: 320px; padding: 14px; 
      border-radius: 24px; display: flex; flex-direction: column; gap: 12px; 
      z-index: 1000; opacity: 0; animation: slideInLeft 1.2s var(--ease) 1s forwards;
      will-change: transform, opacity; user-select: none; -webkit-user-select: none;
    }
    @keyframes slideInLeft { from { opacity: 0; transform: translateX(-30px); } to { opacity: 1; transform: translateX(0); } }

    .player-upper { display: flex; align-items: center; gap: 12px; }
    .album-cover { width: 44px; height: 44px; border-radius: 12px; object-fit: cover; transition: 0.4s var(--ease); pointer-events: none; }
    .is-playing .album-cover { box-shadow: 0 0 20px rgba(0,207,181,0.25); transform: scale(1.02); }

    .song-info { flex: 1; overflow: hidden; }
    .song-name { font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .song-artist { font-size: 11px; color: var(--miku-green); margin-top: 1px; font-weight: 500; }
    
    .play-pause { 
      width: 34px; height: 34px; background: var(--text-dark); color: var(--bg-white); 
      border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: transform 0.2s; flex-shrink: 0;
    }
    .play-pause:active { transform: scale(0.88); transition: transform 0.1s; }
    .play-pause svg { width: 14px; height: 14px; fill: currentColor; }
    #icon-pause { display: none; }
    .is-playing #icon-play { display: none; }
    .is-playing #icon-pause { display: block; }

    /* ✨ 3. a11y: 进度条重构为原生范围输入框 (透明覆盖) */
    .player-progress-zone { display: flex; flex-direction: column; gap: 4px; padding: 0 2px; position: relative; }
    .progress-bar-bg { width: 100%; height: 4px; background: rgba(0,0,0,0.06); border-radius: 2px; position: relative; overflow: hidden; }
    @media (prefers-color-scheme: dark) { .progress-bar-bg { background: rgba(255,255,255,0.1); } }
    .progress-bar-fill { position: absolute; left: 0; top: 0; height: 100%; width: 0%; background: var(--miku-green); border-radius: 2px; transition: width 0.1s linear; pointer-events: none; }
    
    .progress-slider {
      -webkit-appearance: none; appearance: none;
      width: 100%; height: 100%; position: absolute; top: 0; left: 0; margin: 0;
      background: transparent; outline: none; z-index: 2; cursor: pointer;
    }
    .progress-slider::-webkit-slider-thumb { -webkit-appearance: none; width: 0; height: 0; }
    .progress-slider::-moz-range-thumb { width: 0; height: 0; border: none; }

    .player-time-labels { display: flex; justify-content: space-between; font-size: 9px; color: var(--text-gray); font-family: monospace; letter-spacing: 0.05em; pointer-events: none; }

    .contact-panel { position: fixed; right: 25px; bottom: 25px; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; z-index: 1001; pointer-events: none; }
    body.is-bottom .contact-panel { pointer-events: auto; }

    .email-chip { 
      --chip-x: 40px; --chip-op: 0;
      padding: 8px 16px; border-radius: 50px; font-size: 10px; 
      color: var(--text-gray); text-decoration: none; font-family: monospace; 
      cursor: pointer; transform: translateX(var(--chip-x)); opacity: var(--chip-op);
      transition: background 0.3s, color 0.3s, border 0.3s, transform 0.4s var(--ease), opacity 0.4s; user-select: none; -webkit-user-select: none;
    }
    /* ✨ 6. 防止 JS 加载前闪烁 Loading 字样 */
    .email-chip:not([data-ready]) { opacity: 0 !important; pointer-events: none; }

    @media (hover: hover) { .email-chip:hover { background: var(--miku-green); color: white; border-color: var(--miku-green); transform: translateX(calc(var(--chip-x) - 5px)); } }

    @media (max-width: 600px) {
      .nav-grid { grid-template-columns: 1fr; }
      .nav-grid > .nav-item:last-child:nth-child(odd) { grid-column: span 1; }
      .hero h1 { font-size: 3.2rem !important; margin-bottom: 10px; }
      .hero-sub { font-size: 0.75rem; }
      .player-card { width: 190px !important; left: 10px !important; bottom: 10px !important; padding: 10px !important; gap: 6px !important; border-radius: 18px !important; }
      .album-cover { width: 32px !important; height: 32px !important; border-radius: 8px !important; }
      .song-name { font-size: 11px !important; }
      .song-artist { font-size: 9px !important; }
      .play-pause { width: 26px !important; height: 26px !important; }
      .play-pause svg { width: 10px !important; height: 10px !important; }
      .player-time-labels { font-size: 8px !important; }
      .progress-bar-bg { height: 3px !important; }
      .contact-panel { right: 10px !important; bottom: 10px !important; gap: 4px !important; }
      .email-chip { padding: 5px 10px !important; font-size: 8.5px !important; }
      .nav-item { padding: 18px 20px !important; border-radius: 20px !important; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
      .nav-item, .category-title { opacity: 1; transform: translateY(0); filter: none !important; }
      .email-chip { opacity: 1; transform: translateX(0) !important; }
      body.is-idle .bg-glow-1, body.is-idle .bg-glow-2 { animation: none !important; } 
      .hero h1 { filter: none !important; opacity: 1 !important; transform: none !important; }
      .player-card { opacity: 1 !important; transform: none !important; animation: none !important; }
    }
  </style>
</head>
