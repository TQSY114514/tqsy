const sameAsLinks = navData.flatMap(group => group.items.map(item => item.url));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": "TQSY",
    "alternateName": ["天气圣盐", "Weather Holy Salt", "tqishengyan"],
    "description": description,
    "image": globalIcon,
    "url": siteUrl,
    "sameAs": sameAsLinks
